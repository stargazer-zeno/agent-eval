* text=auto eol=lf

# Reproducible text line endings across platforms
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Binary benchmark evidence and game assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
